# ── Server env (validated at boot by src/lib/env.ts) ──────────────────────
# PostgreSQL connection string. Local dev: `docker compose up -d db`
# (host port 5433 to avoid clashing with an existing local Postgres)
DATABASE_URL=postgresql://coaching:coaching@localhost:5433/coaching_ngj

# Absolute origin of the app; used for metadata / canonical URLs.
APP_URL=http://localhost:3000

# ── Filled in by later milestones (shape only — never commit real values) ──
# M1 auth tables + M2 flows: BETTER_AUTH_SECRET, ADMIN_EMAIL (seeded admin, PRD A8),
#               ADMIN_PASSWORD, SMTP_USER, SMTP_PASS (+ optional SMTP_HOST/PORT/FROM, Gmail — ADR 0003),
#               TURNSTILE_SECRET_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
# M4 uploads:   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY,
#               R2_BUCKET, NEXT_PUBLIC_IMAGE_BASE_URL
# M8 errors:    SENTRY_DSN
